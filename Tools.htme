<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Snipzo — Tools</title>
<link rel="stylesheet" href="styles.css">
</head>
<body>

<div class="lab-header">
  <div class="lab-title">
    <h1>Snipzo</h1>
    <span>Tools — नीचे बटन से दूसरे पेज पर जाएँ</span>
  </div>
  <div class="lab-nav">
    <button onclick="go('splash')">Splash Screen</button>
    <button onclick="go('login')">Login</button>
    <button onclick="go('home')">Home</button>
    <button onclick="go('editor')">Video Editor</button>
    <button class="active" onclick="go('tools')">Tools</button>
    <button onclick="go('templates')">Templates</button>
    <button onclick="go('export')">Export</button>
    <button onclick="go('projects')">Projects</button>
    <button onclick="go('profile')">Profile / Settings</button>
  </div>
</div>

<div class="stage">
  <div class="phone">
    <section class="screen active" id="screen-tools">
      <div class="statusbar"><span>9:41</span><div class="icons">📶 📡 🔋</div></div>
      <div class="screen-body">
        <div class="subpage-head"><span class="back-arrow" onclick="go('home')">←</span><h2>Tools</h2></div>
        <div class="pill-tabs">
          <div class="pill active">All</div>
          <div class="pill">Basic</div>
          <div class="pill">Effects</div>
          <div class="pill">AI</div>
          <div class="pill">Audio</div>
        </div>
        <div class="tool-grid">
          <div class="tool-cell"><div class="ic g-cyan">✂️</div><span>Trim &amp; Split</span></div>
          <div class="tool-cell"><div class="ic g-blue">⧉</div><span>Merge</span></div>
          <div class="tool-cell"><div class="ic g-purple">◷</div><span>Speed</span></div>
          <div class="tool-cell"><div class="ic g-pink">T</div><span>Text &amp; Captions</span></div>
          <div class="tool-cell"><div class="ic g-yellow">☺</div><span>Stickers</span></div>
          <div class="tool-cell"><div class="ic g-cyan">🎛️</div><span>Filters</span></div>
          <div class="tool-cell"><div class="ic g-purple">⑃</div><span>Transitions</span></div>
          <div class="tool-cell"><div class="ic g-pink">✨</div><span>Effects</span></div>
          <div class="tool-cell"><div class="ic g-green">▧</div><span>Background Remove</span></div>
          <div class="tool-cell"><div class="ic g-pink">🎨</div><span>Color Adjustment</span></div>
          <div class="tool-cell"><div class="ic g-blue">◆</div><span>Keyframe</span></div>
          <div class="tool-cell"><div class="ic g-purple">⧗</div><span>Stabilization</span></div>
          <div class="tool-cell"><div class="ic g-cyan">▭</div><span>Canvas</span></div>
          <div class="tool-cell"><div class="ic g-yellow">🖼️</div><span>AI Enhance</span></div>
          <div class="tool-cell"><div class="ic g-pink">🎙️</div><span>Voiceover</span></div>
        </div>
      </div>
      <div class="bottom-tabs">
        <div class="tab" onclick="go('home')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>Home</div>
        <div class="tab" onclick="go('projects')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>Projects</div>
        <div class="tab" onclick="go('templates')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>Templates</div>
        <div class="tab" onclick="go('profile')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>Profile</div>
      </div>
    </section>
  </div>
</div>

<script src="script.js"></script>
</body>
  </html>
